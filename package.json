{
  "name": "flowsnap",
  "version": "0.0.3",
  "description": "Playwright reporter that captures E2E test flows as visual HTML documents with screenshots",
  "license": "MIT",
  "author": "bemaru",
  "repository": {
    "type": "git",
    "url": "https://github.com/bemaru/flowsnap"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./fixture": {
      "types": "./dist/fixture.d.ts",
      "import": "./dist/fixture.mjs",
      "require": "./dist/fixture.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "playwright",
    "playwright-reporter",
    "e2e",
    "e2e-testing",
    "screenshot",
    "flow",
    "reporter",
    "ctrf",
    "test",
    "testing",
    "visual",
    "html-report",
    "test-report",
    "test-visualization",
    "user-flow",
    "user-journey"
  ]
}
